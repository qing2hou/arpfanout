# arpfanout 配置
# 白名单为空 = 跟随系统内所有 bond(推荐, 改名/新建自动跟随)
# 如需限定: ARP_FANOUT_BONDS="bond0 bond2"
ARP_FANOUT_BONDS=""
# 轮询兜底间隔(秒)
ARP_FANOUT_POLL=5
# tc filter 优先级(数值越小越先执行)。默认 49152, 与旧版自动分配的结果一致。
# 机器上其他组件也在 bond egress 挂 filter 时, 显式固定此值可避免顺序漂移;
# 需要看 ARP/NDP 的规则放在更小的 pref, 只看业务流量的规则可放任意位置。
# 若 49152 已被其他类型的 filter 占用(tc 会报 kind/protocol 冲突), 改成
# 一个空闲值即可, 如 ARP_FANOUT_PREF=50000
ARP_FANOUT_PREF=49152
# 可选: 手工指定 bpftool 绝对路径(默认自动探测: 当前内核 → PATH → 已装 linux-tools)
# 内核升级后 Ubuntu 的 /usr/sbin/bpftool wrapper 可能找不到对应工具包, 一般无需手工设置
# ARP_FANOUT_BPFTOOL=/usr/lib/linux-tools/5.15.0-203-generic/bpftool
